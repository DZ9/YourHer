# Offline demo is the default. No credentials or cloud account required.
MODEL_PROVIDER=demo
PORT=4317
DATA_DIR=.data-web
# For Docker, set HOST=0.0.0.0. Set PUBLIC_ORIGIN to the exact external origin.
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://your-instance.example
# Optional hourly Sunday letter generation; real-model mode may incur API costs.
AUTO_WEEKLY_LETTERS=false
# Set MODEL_PROVIDER=openai-compatible to use a real model.
# A chat turn may make two requests: reply generation and fact extraction.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# Optional alternate branding/language configuration
# CONFIG_FILE=/absolute/path/to/companion.config.json
