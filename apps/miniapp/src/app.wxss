@font-face { font-family: "Material Symbols Outlined"; src: url("data:font/ttf;base64,"); }
@font-face { font-family: "Material Icons"; src: url("data:font/ttf;base64,"); }


page {
  min-height: 100%;
  background: #F5F1E8;
  color: #3B3528;
  font-size: 30rpx;
  font-family: "PingFang SC", "Helvetica Neue", system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  line-height: 1;
  background: transparent;
  color: inherit;
}

button::after {
  border: none;
}

input,
textarea {
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
  position: relative;
  box-sizing: border-box;
  overflow-x: hidden;
  background: #F5F1E8;
}

.serif {
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
}

.sans {
  font-family: "PingFang SC", "Helvetica Neue", system-ui, sans-serif;
}

.mono {
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
  letter-spacing: 1.4rpx;
  text-transform: uppercase;
}

.headline {
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-weight: 600;
  letter-spacing: -1rpx;
  color: #3B3528;
}

.kicker {
  font-size: 22rpx;
  color: #9A8F77;
  font-weight: 500;
  letter-spacing: 1.2rpx;
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
}

.section-label {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 56rpx 0 28rpx;
}

.section-label__title {
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 36rpx;
  font-weight: 600;
  color: #3B3528;
  letter-spacing: -0.4rpx;
}

.section-label__trail {
  font-size: 22rpx;
  color: #9A8F77;
  font-weight: 500;
}

.body-muted {
  color: #9A8F77;
}

.card {
  background: #FBF8F0;
  border: 1rpx solid #E8DFC9;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.card--cream {
  background: #FFFCF4;
}

.hairline {
  height: 1rpx;
  background: #DCD2BB;
}

.hairline--soft {
  background: #E8DFC9;
}

.capsule-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.deskbar {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 28rpx 16rpx 28rpx;
  box-sizing: border-box;
}

.deskbar__back {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 22rpx 14rpx 18rpx;
  background: #FFFCF4;
  border: 1rpx solid #E8DFC9;
  border-radius: 28rpx;
  box-shadow: 0 4px 14px -4px rgba(120, 100, 60, 0.12);
}

.deskbar__back-icon {
  width: 32rpx;
  height: 24rpx;
  display: block;
}

.deskbar__back-label {
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 24rpx;
  font-weight: 600;
  color: #3B3528;
  letter-spacing: 0.6rpx;
}

.deskbar__title-wrap {
  flex: 1;
  min-width: 0;
}

.deskbar__kicker {
  font-family: "PingFang SC", "Helvetica Neue", system-ui, sans-serif;
  font-size: 22rpx;
  color: #9A8F77;
  letter-spacing: 0.8rpx;
  font-weight: 500;
}

.deskbar__title {
  margin-top: 4rpx;
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #3B3528;
  letter-spacing: 0.4rpx;
}

.btn-matcha {
  width: 100%;
  min-height: 96rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #7A9869;
  color: #FFFCF4;
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1.2rpx;
  box-shadow: 0 14rpx 36rpx -12rpx rgba(122, 152, 105, 0.55);
}

.btn-matcha--disabled {
  background: #E8DFC9;
  color: #9A8F77;
  box-shadow: none;
}

.btn-ghost {
  width: 100%;
  min-height: 96rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 1rpx solid #DCD2BB;
  color: #3B3528;
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 30rpx;
  font-weight: 500;
}

.chip {
  min-height: 56rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 1rpx solid #DCD2BB;
  color: #3B3528;
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 24rpx;
  font-weight: 500;
}

.chip--active {
  background: #E5ECDA;
  color: #7A9869;
  border-color: #C8D6B4;
}

.field-input,
.field-textarea {
  width: 100%;
  border: none;
  background: transparent;
  color: #3B3528;
  font-size: 30rpx;
  line-height: 1.6;
}

.field-placeholder {
  color: rgba(154, 143, 119, 0.7);
  font-style: italic;
}

.mood-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid #3B3528;
  box-sizing: border-box;
}

.mood-dot--happy { background: #9CB587; }
.mood-dot--calm  { background: #C7BCA1; }
.mood-dot--sad   { background: #A8B8C4; }

.symbol {
  font-family: "Material Symbols Outlined", sans-serif;
  font-weight: 400;
  font-style: normal;
  font-size: 40rpx;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  letter-spacing: normal;
  word-wrap: normal;
  direction: ltr;
  text-transform: none;
  -webkit-font-feature-settings: "liga";
  font-feature-settings: "liga";
  -webkit-font-smoothing: antialiased;
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

.symbol--fill {
  font-variation-settings: "FILL" 1, "wght" 400, "GRAD" 0, "opsz" 24;
}

.symbol--solid {
  font-family: "Material Icons", "Material Symbols Outlined", sans-serif;
}

.paper-grain {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(680rpx 420rpx at 0% 0%, rgba(229, 236, 218, 0.55) 0%, transparent 60%),
    radial-gradient(420rpx 320rpx at 100% 18%, rgba(244, 221, 165, 0.36) 0%, transparent 60%);
}

.surface-card,
.soft-card,
.glass-card {
  background: #FBF8F0;
  border: 1rpx solid #E8DFC9;
  border-radius: 28rpx;
  box-shadow: none;
}

.eyebrow {
  color: #9A8F77;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
}

.gradient-button {
  width: 100%;
  min-height: 96rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #7A9869;
  color: #FFFCF4;
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 32rpx;
  font-weight: 600;
}

.empty-state {
  margin-top: 80rpx;
  padding: 48rpx 36rpx;
  text-align: center;
}

.empty-state__icon {
  color: #9A8F77;
  font-size: 80rpx;
}

.empty-state__title {
  display: block;
  margin-top: 24rpx;
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 40rpx;
  font-weight: 600;
  color: #3B3528;
}

.empty-state__desc {
  display: block;
  margin-top: 16rpx;
  color: #9A8F77;
  font-size: 26rpx;
  line-height: 1.8;
}

.app-topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 28;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
  background: transparent;
}

.app-topbar__row {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.app-topbar__lead,
.app-topbar__trail {
  min-width: 0;
  display: flex;
  align-items: center;
}

.app-topbar__lead {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  justify-content: flex-start;
}

.app-topbar__trail {
  margin-left: auto;
  justify-content: flex-end;
}
