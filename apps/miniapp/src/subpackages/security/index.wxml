<view class="page-shell"><view style="padding:100rpx 40rpx;line-height:1.9"><text style="font-size:42rpx">YourHer · 账号与数据</text><view>{{account.wechatBound ? "已关联微信账号" : "当前使用设备访客会话"}}</view><button wx:if="{{account.wechatLoginAvailable && !account.wechatBound}}" disabled="{{busy}}" bindtap="handleWechatLogin">关联或恢复微信账号</button><button wx:if="{{account.wechatBound && !account.phoneBound}}" open-type="getPhoneNumber" disabled="{{busy}}" bindgetphonenumber="handleBindPhone">绑定手机号</button><view wx:if="{{account.phoneBound}}">{{account.phoneMasked}}</view><button wx:if="{{account.paymentAvailable && !pendingOrder}}" disabled="{{busy}}" bindtap="handlePurchase">开通 30 天会员（{{account.paymentPriceFen / 100}} 元）</button><view wx:if="{{account.subscriptionActive}}">会员有效期至 {{account.subscriptionExpireAt}}</view><button wx:if="{{pendingOrder}}" disabled="{{busy}}" bindtap="handleConfirmPurchase">查询付款状态</button><button wx:if="{{pendingOrder}}" disabled="{{busy}}" bindtap="handleDismissOrder">清除本机订单提示</button><button wx:if="{{account.weeklyTemplateId}}" bindtap="handleSubscribe">订阅下次信件通知</button><view wx:if="{{error}}">{{error}}</view><button loading="{{busy}}" bindtap="handleExport">导出我的数据</button><button disabled="{{busy}}" bindtap="handleDelete">删除我的全部数据</button><button bindtap="handleBack">返回</button></view></view>
