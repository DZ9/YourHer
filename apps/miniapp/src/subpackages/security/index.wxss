
page {
  background: #221a18;
}

.security-page {
  min-height: 100vh;
  background: #221a18;
  color: #f3e9e2;
}

.security-scroll {
  height: 100vh;
}

.security-main {
  max-width: 686rpx;
  margin: 0 auto;
  padding: 0 32rpx;
}

.security-hero {
  padding: 0 0 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.security-hero__badge {
  width: 128rpx;
  height: 128rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E5ECDA;
  border: 1rpx solid rgba(122, 152, 105, 0.42);
  box-shadow: 0 14rpx 30rpx -10rpx rgba(120, 100, 60, 0.22);
}

.security-hero__icon {
  color: #7A9869;
  font-size: 56rpx;
}

.security-hero__copy {
  margin-top: 18rpx;
  color: #6B5F4A;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  font-style: italic;
}

.security-card {
  overflow: hidden;
  border-radius: 28rpx;
  background: #2c221e;
  border: 1rpx solid #3a2e2a;
  box-shadow: 0 8rpx 24rpx -10rpx rgba(120, 100, 60, 0.18);
}

.security-row {
  width: 100%;
  min-height: 108rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  text-align: left;
  background: transparent;
}

.security-row::after {
  border: none;
}

.security-row__main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.security-row__icon {
  color: #b09a8c;
  font-size: 32rpx;
}

.security-row__icon--danger {
  color: #C97D5C;
}

.security-row__title {
  color: #f3e9e2;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.4rpx;
}

.security-row__title--danger {
  color: #C97D5C;
}

.security-row__value {
  color: #6B5F4A;
  font-size: 24rpx;
}

.security-row__arrow {
  color: rgba(154, 143, 119, 0.7);
}

.security-card__divider {
  height: 1rpx;
  margin: 0 28rpx;
  background: #3a2e2a;
}

.security-footnote {
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.security-logout {
  width: 100%;
  min-height: 96rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: rgba(201, 125, 92, 0.12);
  border: 1rpx solid rgba(201, 125, 92, 0.35);
  color: #C97D5C;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.6rpx;
}

.security-logout::after {
  border: none;
}

.security-logout--pressed {
  transform: scale(0.99);
  background: rgba(201, 125, 92, 0.2);
}

.security-logout__icon {
  font-size: 30rpx;
}

.security-logout__text {
  line-height: 1;
}

.security-footnote__icon {
  color: rgba(122, 152, 105, 0.72);
  font-size: 24rpx;
}

.security-footnote__text {
  color: #b09a8c;
  font-size: 18rpx;
  font-weight: 500;
  letter-spacing: 1.4rpx;
}

.security-scroll__bottom {
  height: calc(232rpx + env(safe-area-inset-bottom));
}

.security-page.tod-night {
  background: #221836;
  color: #F4EFE2;
}

.security-page.tod-night .app-topbar__title {
  color: #F4EFE2;
}

.security-page.tod-night .app-topbar__action--ghost {
  color: #F4EFE2;
}

.security-page.tod-night .security-hero__badge {
  background: rgba(122, 152, 105, 0.22);
  border-color: rgba(122, 152, 105, 0.45);
  box-shadow: 0 14rpx 30rpx -10rpx rgba(0, 0, 0, 0.45);
}

.security-page.tod-night .security-hero__icon {
  color: #A8C795;
}

.security-page.tod-night .security-hero__copy {
  color: rgba(244, 239, 226, 0.7);
}

.security-page.tod-night .security-card {
  background: rgba(244, 239, 226, 0.06);
  border-color: rgba(244, 239, 226, 0.18);
  box-shadow: 0 8rpx 24rpx -10rpx rgba(0, 0, 0, 0.45);
}

.security-page.tod-night .security-row__icon {
  color: rgba(244, 239, 226, 0.55);
}

.security-page.tod-night .security-row__title {
  color: #F4EFE2;
}

.security-page.tod-night .security-row__value {
  color: rgba(244, 239, 226, 0.7);
}

.security-page.tod-night .security-row__arrow {
  color: rgba(244, 239, 226, 0.45);
}

.security-page.tod-night .security-card__divider {
  background: rgba(244, 239, 226, 0.12);
}

.security-page.tod-night .security-logout {
  background: rgba(232, 158, 125, 0.16);
  border-color: rgba(232, 158, 125, 0.4);
  color: #E89E7D;
}

.security-page.tod-night .security-logout--pressed {
  background: rgba(232, 158, 125, 0.26);
}

.security-page.tod-night .security-footnote__icon {
  color: rgba(168, 199, 149, 0.7);
}

.security-page.tod-night .security-footnote__text {
  color: rgba(244, 239, 226, 0.55);
}
