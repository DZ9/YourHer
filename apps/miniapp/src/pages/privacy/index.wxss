

.privacy-page {
  position: relative;
  width: 100%;
  height: 100vh;
  background: #F4EFE6;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.privacy-page__topbar {
  flex: 0 0 auto;
  background: #F4EFE6;
  border-bottom: 1rpx solid rgba(168, 133, 98, 0.18);
}

.privacy-page__topbar-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.privacy-page__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3A2E22;
}

.privacy-page__tabs {
  display: flex;
  padding: 16rpx 32rpx 12rpx;
  gap: 24rpx;
}

.privacy-page__tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #b09a8c;
  border-bottom: 4rpx solid transparent;
  transition: color 0.2s, border-color 0.2s;
}

.privacy-page__tab--active {
  color: #7A9869;
  border-bottom-color: #7A9869;
  font-weight: 600;
}

.privacy-page__body {
  flex: 1 1 auto;
  padding: 24rpx 36rpx 0;
  overflow: hidden;
}

.privacy-page__updated {
  display: block;
  font-size: 22rpx;
  color: #b09a8c;
  margin-bottom: 24rpx;
  letter-spacing: 0.04em;
}

.privacy-page__section {
  margin-bottom: 36rpx;
}

.privacy-page__h2 {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #3A2E22;
  margin-bottom: 12rpx;
}

.privacy-page__p {
  display: block;
  font-size: 26rpx;
  line-height: 1.75;
  color: #4A3F32;
  margin-bottom: 10rpx;
  word-break: break-all;
}

.privacy-page__bottom-spacer {
  height: 40rpx;
}

.privacy-page__footer {
  flex: 0 0 auto;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 36rpx 0;
  background: #F4EFE6;
  border-top: 1rpx solid rgba(168, 133, 98, 0.18);
}

.privacy-page__btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.privacy-page__btn--ghost {
  background: transparent;
  border: 1rpx solid #A88562;
  color: #6A553C;
}

.privacy-page__btn--primary {
  background: #7A9869;
  color: #FFFFFF;
  font-weight: 600;
}

.privacy-page__body { height: 0; box-sizing: border-box; }
.privacy-page__footer { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.privacy-page.tod-night,
.privacy-page.tod-night .privacy-page__topbar,
.privacy-page.tod-night .privacy-page__footer { background: #1F2236; }
.privacy-page.tod-night .privacy-page__title,
.privacy-page.tod-night .privacy-page__h2 { color: #F4EFE2; }
.privacy-page.tod-night .privacy-page__p { color: #D6CCDD; }
.privacy-page.tod-night .privacy-page__btn--ghost { color: #F4EFE2; border-color: #86798E; }
