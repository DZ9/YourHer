  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  transition: background 800ms ease;
}

.chat-ai-notice {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 38;
  text-align: center;
  font-size: 20rpx;
