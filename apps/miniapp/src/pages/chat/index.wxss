

page {

  background: #221a18;
}

.chat-page {

  --bg: #221a18;
  --bg-feather: #1a1311;
  --ink: #f3e9e2;
  --sub-ink: #b09a8c;
  --face: #2a201c;
  --face-stroke: #f3e9e2;
  --cheek: #e8a06a;

  --halo: #e8a06a;
  --halo-glow: rgba(232, 160, 106, 0.38);
  --bubble-her-bg: rgba(40, 32, 28, 0.62);
  --bubble-her-border: rgba(232, 180, 140, 0.22);
  --bubble-user-bg: rgba(232, 160, 106, 0.32);
  --bubble-user-border: rgba(240, 190, 150, 0.4);
  --bubble-user-ink: #fff3e8;
  --compose-bg: rgba(26, 20, 18, 0.66);
  --compose-input-bg: rgba(255, 255, 255, 0.12);
  --compose-input-border: rgba(232, 180, 140, 0.3);
  --robe: #4a3530;
  --robe-accent: #e8a06a;
  --ambient: radial-gradient(ellipse 70% 90% at 50% 35%, #3a2e2a 0%, #2c211d 50%, #221a18 100%);
  --topbar-chip-bg: rgba(255, 255, 255, 0.12);
  --topbar-chip-border: rgba(232, 180, 140, 0.28);
  --send-rest-bg: rgba(255, 255, 255, 0.12);
  --send-active-bg: linear-gradient(135deg, #f0a868, #e0824e);
  --send-icon: #fff;
  --whisper-color: rgba(243, 233, 226, 0.66);
  --bubble-shadow: 0 8rpx 22rpx -12rpx rgba(0, 0, 0, 0.6);

  --art-wash: linear-gradient(160deg, rgba(150, 95, 55, 0.30) 0%, rgba(70, 45, 32, 0.16) 50%, rgba(40, 28, 24, 0.04) 100%);
  --art-topveil: linear-gradient(180deg, rgba(18, 13, 11, 0.6) 0%, rgba(18, 13, 11, 0) 100%);
  --veil: linear-gradient(180deg, transparent 0%, rgba(28, 20, 18, 0.5) 42%, rgba(18, 13, 11, 0.97) 100%);
  --art-grad: linear-gradient(165deg, #3a2e2a 0%, #4a3530 42%, #281e1c 100%);
  --scrim-thread: rgba(18, 13, 11, 0.82);

  background: var(--bg);
  color: var(--ink);
  min-height: 100vh;
  position: relative;
  overflow: hidden;

}

.chat-page.tod-night {
  --bg: #221836;
  --bg-feather: #18102a;
  --ink: #f1e8f4;
  --sub-ink: #b49ec4;
  --face: #302244;
  --face-stroke: #f1e8f4;
  --cheek: #d98fc4;
  --halo: #e6b96a;
  --halo-glow: rgba(230, 185, 106, 0.38);
  --bubble-her-bg: rgba(48, 34, 68, 0.6);
  --bubble-her-border: rgba(214, 169, 216, 0.26);
  --bubble-user-bg: rgba(200, 140, 200, 0.3);
  --bubble-user-border: rgba(220, 170, 220, 0.4);
  --bubble-user-ink: #fbeefb;
  --compose-bg: rgba(28, 18, 44, 0.66);
  --compose-input-bg: rgba(255, 255, 255, 0.12);
  --compose-input-border: rgba(214, 169, 216, 0.3);
  --robe: #4e2f54;
  --robe-accent: #e6b96a;
  --ambient: radial-gradient(ellipse 70% 90% at 50% 35%, #3a2a4e 0%, #2c1e44 50%, #221836 100%);
  --topbar-chip-bg: rgba(255, 255, 255, 0.12);
  --topbar-chip-border: rgba(214, 169, 216, 0.3);
  --send-rest-bg: rgba(255, 255, 255, 0.12);
  --send-active-bg: linear-gradient(135deg, #e6b96a, #d98fc4);
  --send-icon: #3a2a18;
  --whisper-color: rgba(241, 232, 244, 0.66);
  --bubble-shadow: 0 8rpx 24rpx -12rpx rgba(0, 0, 0, 0.6);
  --art-wash: linear-gradient(160deg, rgba(125, 70, 140, 0.34) 0%, rgba(80, 45, 110, 0.18) 50%, rgba(40, 24, 60, 0.05) 100%);
  --art-topveil: linear-gradient(180deg, rgba(24, 15, 38, 0.6) 0%, rgba(24, 15, 38, 0) 100%);
  --veil: linear-gradient(180deg, transparent 0%, rgba(40, 24, 56, 0.5) 40%, rgba(24, 15, 38, 0.97) 100%);
  --art-grad: linear-gradient(165deg, #3a2a4e 0%, #4e2f54 45%, #281a3c 100%);
  --scrim-thread: rgba(24, 15, 38, 0.82);
}

.chat-art {
  position: fixed;
  inset: 0;
  z-index: 0;
  background: var(--art-grad);
  overflow: hidden;
  pointer-events: none;
}

.chat-art__img {

  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.chat-art__wash {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: var(--art-wash);
  transition: background 800ms ease;
}

.chat-art__topveil {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 360rpx;
  z-index: 2;
  background: var(--art-topveil);
}

.chat-art__veil {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  z-index: 2;
  background: var(--veil);
  transition: background 800ms ease;
}

.chat-stars {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  height: 46%;
  z-index: 3;
  pointer-events: none;
}

.chat-star {
  position: absolute;
  border-radius: 50%;
  background: #e8e2f0;
  box-shadow: 0 0 8rpx rgba(220, 210, 240, 0.7);
  animation: chat-star-twinkle ease-in-out infinite;
}

@keyframes chat-star-twinkle {
  0%, 100% { opacity: 0.25; }
  50%      { opacity: 1; }
}

.chat-thread-scrim {
  position: fixed;
  inset: 0;
  z-index: 5;
  background: var(--scrim-thread);
  opacity: 0;
  pointer-events: none;
  transition: opacity 160ms ease;
}

.imm-name {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 11;
  text-align: center;
  pointer-events: none;
}

.imm-name__n {
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 3rpx;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.55);
}

.imm-name__s {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--halo);
  letter-spacing: 1.5rpx;
  text-shadow: 0 1rpx 10rpx rgba(0, 0, 0, 0.5);
}

.imm-name__ai {
  display: inline-block;
  margin-top: 12rpx;
  padding: 3rpx 16rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  letter-spacing: 0.5rpx;
  color: var(--sub-ink);
  background: rgba(0, 0, 0, 0.28);
  border: 1rpx solid var(--topbar-chip-border);
}

.portrait-header {
  position: relative;
  width: 100%;
  height: 640rpx;
  overflow: hidden;
}

.portrait-ambient {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--ambient);
  transition: background 800ms ease;
}

.portrait-feather {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 220rpx;
  background: linear-gradient(180deg,
    transparent 0%,
    var(--bg-feather) 55%,
    var(--bg-feather) 100%
  );
  pointer-events: none;
}

.portrait-whisper {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 56rpx;
  text-align: center;
  font-style: italic;
  font-size: 26rpx;
  letter-spacing: 2.4rpx;
  color: var(--whisper-color);
  pointer-events: none;
  transition: color 400ms ease;
}

.portrait-sun {
  position: absolute;
  left: 50%;
  top: 55%;
  width: 120%;
  height: 120%;
  border-radius: 50%;
  background: radial-gradient(closest-side, var(--halo-glow) 0%, transparent 70%);
  transform: translate(-50%, -50%);
  pointer-events: none;
  filter: blur(20rpx);
  transition: background 1200ms ease;
}

.portrait-stars {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  overflow: hidden;
}

.portrait-star {
  position: absolute;
  border-radius: 50%;
  background: #F4EFE2;
  opacity: 0.6;
  animation: portrait-star-twinkle ease-in-out infinite;
}

@keyframes portrait-star-twinkle {
  0%, 100% { opacity: 0.25; transform: scale(0.85); }
  50%      { opacity: 0.85; transform: scale(1.08); }
}

.portrait-moon {
  position: absolute;
  right: 80rpx;
  top: 120rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #F4EFE2;
  box-shadow: -10rpx 4rpx 0 -2rpx #1F2236, 0 0 16rpx 2rpx rgba(244, 239, 226, 0.35);
  opacity: 0.85;
}

.portrait-figure {

  --tilt: 0deg;
  position: absolute;
  left: 50%;
  top: 60rpx;
  width: 480rpx;
  height: 480rpx;
  transform-origin: 50% 30%;
  animation: portrait-breath 4s ease-in-out infinite;
}

@keyframes portrait-breath {
  0%, 100% { transform: translateX(-50%) translateY(0)    scale(1)     rotate(var(--tilt, 0deg)); }
  50%      { transform: translateX(-50%) translateY(3rpx) scale(1.012) rotate(var(--tilt, 0deg)); }
}

.state-listening .portrait-figure { --tilt: 1.6deg; }
.state-thinking  .portrait-figure { --tilt: -0.6deg; }

.state-speaking .portrait-figure {
  animation: portrait-breath-speak 0.6s ease-in-out infinite;
}

@keyframes portrait-breath-speak {
  0%, 100% { transform: translateX(-50%) translateY(0)     scale(1)    rotate(var(--tilt, 0deg)); }
  50%      { transform: translateX(-50%) translateY(-3rpx) scale(1.02) rotate(var(--tilt, 0deg)); }
}

.portrait-svg {
  position: absolute;
  left: 50%;
  top: 0;

  width: 360rpx;
  height: 450rpx;
  transform: translateX(-50%);
  pointer-events: none;
}

.portrait-thought {
  position: absolute;
  left: 50%;
  top: 40rpx;
  width: 80rpx;
  height: 16rpx;
  transform: translateX(-50%);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
}

.portrait-thought__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--face-stroke);
  opacity: 0.6;
  animation: portrait-thought-pulse 1.2s ease-in-out infinite;
}

.portrait-thought__dot:nth-child(1) { animation-delay: 0s; }
.portrait-thought__dot:nth-child(2) { animation-delay: 0.2s; transform: scale(1.2); }
.portrait-thought__dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes portrait-thought-pulse {
  0%, 100% { opacity: 0.25; }
  50%      { opacity: 1; }
}

.portrait-listen {
  position: absolute;


  right: 80rpx;
  top: 180rpx;
  width: 30rpx;
  height: 30rpx;
}

.portrait-listen__dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--halo);
  transform: translate(-50%, -50%);
}

.portrait-listen__ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2rpx solid var(--halo);
  transform: translate(-50%, -50%);
  animation: portrait-listen-ping 1.4s ease-out infinite;
}

@keyframes portrait-listen-ping {
  0%   { width: 12rpx; height: 12rpx; opacity: 0.85; }
  100% { width: 56rpx; height: 56rpx; opacity: 0; }
}

.chat-deskbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 30;
  padding: 0 28rpx 0 24rpx;
  background: transparent;
  transition: background 300ms ease;
}

.chat-page.is-scrolled .chat-deskbar {
  background: linear-gradient(to bottom, var(--bg) 60%, rgba(0, 0, 0, 0) 100%);
  backdrop-filter: saturate(150%) blur(8rpx);
}

.chat-deskbar__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
}

.chat-deskbar__back {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 22rpx 14rpx 18rpx;
  background: var(--topbar-chip-bg);
  border: 1rpx solid var(--topbar-chip-border);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 12rpx -4rpx rgba(120, 100, 60, 0.12);
  transition: background 600ms ease, border-color 600ms ease;
}

.chat-deskbar__desk-icon {
  width: 40rpx;
  height: 32rpx;
  position: relative;
}

.chat-deskbar__desk-top {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  top: 8rpx;
  height: 6rpx;
  background: var(--robe);
  border: 1rpx solid var(--ink);
  border-radius: 2rpx;
}

.chat-deskbar__desk-leg {
  position: absolute;
  top: 14rpx;
  width: 2rpx;
  height: 14rpx;
  background: var(--ink);
}

.chat-deskbar__desk-leg--l { left: 10rpx; }
.chat-deskbar__desk-leg--r { right: 10rpx; }

.chat-deskbar__desk-cup {
  position: absolute;
  left: 50%;
  top: 4rpx;
  transform: translateX(-50%);
  width: 12rpx;
  height: 4rpx;
  background: var(--bubble-user-bg);
  border: 1rpx solid var(--ink);
  border-radius: 2rpx;
}

.chat-deskbar__back-label {
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.6rpx;
}

.chat-deskbar__ai-label {
  font-size: 22rpx;
  color: var(--ink);
  opacity: 0.42;
  letter-spacing: 0.5rpx;
}

.chat-deskbar__collapsed {
  display: flex;
  align-items: center;
  gap: 12rpx;
  transition: opacity 300ms ease, transform 300ms ease;
  pointer-events: none;
}

.chat-deskbar__mini {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--face);
  border: 2rpx solid var(--face-stroke);
  flex-shrink: 0;
  transition: background 800ms ease, border-color 800ms ease;
}

.chat-deskbar__mini-eye {
  position: absolute;
  top: 22rpx;
  width: 5rpx;
  height: 10rpx;
  background: var(--face-stroke);
  border-radius: 50%;
  animation: chat-mini-blink 5.6s ease-in-out infinite;
}

@keyframes chat-mini-blink {
  0%, 92%, 100% { transform: scaleY(1); }
  94%, 96%      { transform: scaleY(0.08); }
}

.chat-deskbar__mini-eye--l { left: 16rpx; }
.chat-deskbar__mini-eye--r { right: 16rpx; }

.chat-deskbar__mini-mouth {
  position: absolute;
  left: 50%;
  top: 36rpx;
  width: 18rpx;
  height: 8rpx;
  border-bottom: 2rpx solid var(--face-stroke);
  border-radius: 0 0 50% 50% / 0 0 100% 100%;
  transform: translateX(-50%);
}

.chat-deskbar__title-wrap {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.chat-deskbar__kicker {
  font-size: 20rpx;
  color: var(--sub-ink);
  letter-spacing: 1.2rpx;
  font-weight: 500;
}

.chat-deskbar__title {
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.4rpx;
  margin-top: 2rpx;
}

.chat-scroll {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10;
  transform: scaleY(-1);
}

.chat-scroll__content {
  padding: 24rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.chat-empty,
.chat-thread {
  transform: scaleY(-1);
}

.chat-empty {
  margin: 200rpx auto 0;
  text-align: center;
}

.chat-empty__icon {
  color: var(--sub-ink);
  font-size: 80rpx;
}

.chat-empty__title {
  display: block;
  margin-top: 24rpx;
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
}

.chat-empty__desc {
  display: block;
  margin-top: 12rpx;
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  color: var(--sub-ink);
  font-size: 24rpx;
  line-height: 1.6;
  max-width: 480rpx;
  margin-left: auto;
  margin-right: auto;
}

.chat-thread {
  display: flex;

  flex-direction: column-reverse;
  gap: 18rpx;
}

.chat-history-more {
  text-align: center;
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 22rpx;
  color: var(--sub-ink);
  font-style: italic;
  padding: 16rpx 0;
}

.chat-refresher {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.chat-refresher__text {
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 22rpx;
  color: var(--sub-ink);
  font-style: italic;
  letter-spacing: 1.2rpx;
}

.chat-separator {
  align-self: center;
  padding: 18rpx 24rpx 8rpx;
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 22rpx;
  color: var(--sub-ink);
  font-weight: 500;
  letter-spacing: 1.2rpx;
  font-style: italic;
}

.chat-message {
  display: flex;
  align-items: flex-end;
  max-width: 86%;
}

.chat-message--user {
  align-self: flex-end;
}

.chat-message--her {
  align-self: flex-start;
}

.chat-bubble {
  padding: 22rpx 28rpx;
  border-radius: 28rpx;
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.65;
  letter-spacing: 0.3rpx;
  box-shadow: var(--bubble-shadow);
  transition: background 600ms ease, border-color 600ms ease, color 600ms ease;
}

.chat-bubble__text {
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}

.chat-bubble--her {
  background: var(--bubble-her-bg);
  border: 1rpx solid var(--bubble-her-border);
  border-top-left-radius: 12rpx;
}

.chat-bubble--user {
  background: var(--bubble-user-bg);
  border: 1rpx solid var(--bubble-user-border);
  border-top-right-radius: 12rpx;

  color: var(--bubble-user-ink);
}

.chat-bubble--pending {
  opacity: 0.7;
}

.chat-bubble--typing {
  padding: 18rpx 24rpx;
}

.chat-typing {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 24rpx;
}

.chat-typing__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--halo);
  animation: chat-typing-dot 1.3s ease-in-out infinite;
}

.chat-typing__dot:nth-child(2) { animation-delay: 0.18s; }
.chat-typing__dot:nth-child(3) { animation-delay: 0.36s; }

@keyframes chat-typing-dot {
  0%   { opacity: 0.25; transform: translateY(0); }
  40%  { opacity: 1;    transform: translateY(-3rpx); }
  80%  { opacity: 0.25; transform: translateY(0); }
  100% { opacity: 0.25; transform: translateY(0); }
}

.chat-memory-banner {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  z-index: 35;

  background: rgba(44, 34, 30, 0.96);
  border: 1rpx solid rgba(232, 180, 140, 0.24);
  border-left: 6rpx solid var(--halo);
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  box-shadow: 0 16rpx 40rpx -16rpx rgba(0, 0, 0, 0.28);
  transition: background 600ms ease, border-color 600ms ease;
  animation: chat-memory-banner-in 280ms ease;
}

@keyframes chat-memory-banner-in {
  from {
    opacity: 0;
    transform: translateY(-12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.chat-memory-banner__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.chat-memory-banner__title {
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
  font-size: 22rpx;
  color: var(--halo);
  font-weight: 700;
  letter-spacing: 1.2rpx;
  text-transform: uppercase;
}

.chat-memory-banner__action {
  font-size: 22rpx;
  color: var(--sub-ink);
}

.chat-memory-banner__quote {
  display: block;
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.6;
}

.chat-memory-banner__extra {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--sub-ink);
}

.chat-memory-banner__undo {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #C97D5C;
  font-weight: 500;
}

.chat-page.tod-night .chat-memory-banner {
  background: rgba(44, 30, 62, 0.96);
  border-color: rgba(214, 169, 216, 0.26);
  border-left-color: #e6b96a;
  box-shadow: 0 16rpx 44rpx -12rpx rgba(0, 0, 0, 0.62);
}

.chat-page.tod-night .chat-memory-banner__title {
  color: #e6b96a;
}

