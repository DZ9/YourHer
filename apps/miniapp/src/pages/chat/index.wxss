}

.chat-voice-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(31, 34, 54, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: chat-voice-mask-in 180ms ease-out;
}

.chat-page.tod-night .chat-voice-mask {
  background: rgba(15, 17, 28, 0.55);
}

@keyframes chat-voice-mask-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.chat-voice-card {
  position: relative;
  width: 520rpx;
  padding: 56rpx 48rpx 44rpx;
  border-radius: 36rpx;

  background: rgba(44, 34, 30, 0.96);
  border: 1rpx solid rgba(232, 180, 140, 0.24);
  box-shadow: 0 24rpx 48rpx -16rpx rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: background 300ms ease, border-color 300ms ease;
}

.chat-page.tod-night .chat-voice-card {
  background: rgba(44, 30, 62, 0.96);
  border-color: rgba(214, 169, 216, 0.24);
  box-shadow: 0 24rpx 48rpx -16rpx rgba(0, 0, 0, 0.6);
}

.chat-page.tod-night .chat-voice-card__hint {
  color: #f1e8f4;
}

.chat-page.tod-night .chat-voice-card__sub {
  color: rgba(241, 232, 244, 0.62);
}

.chat-voice-card--cancel {
  background: rgba(201, 125, 92, 0.16);
  border-color: rgba(201, 125, 92, 0.55);
}

.chat-voice-card__halo {
  position: absolute;
  left: 50%;
  top: -56rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  transform: translateX(-50%);
  background: radial-gradient(closest-side, rgba(122, 152, 105, 0.45) 0%, rgba(122, 152, 105, 0) 70%);
  animation: chat-voice-halo 1.6s ease-in-out infinite;
}

.chat-voice-card--cancel .chat-voice-card__halo {
  background: radial-gradient(closest-side, rgba(201, 125, 92, 0.55) 0%, rgba(201, 125, 92, 0) 70%);
}

@keyframes chat-voice-halo {
  0%, 100% { transform: translateX(-50%) scale(1);    opacity: 0.85; }
  50%      { transform: translateX(-50%) scale(1.15); opacity: 0.45; }
}

.chat-voice-card__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--send-active-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 24rpx -8rpx rgba(122, 152, 105, 0.55);
}

.chat-voice-card--cancel .chat-voice-card__icon {
  background: #C97D5C;
  box-shadow: 0 12rpx 24rpx -8rpx rgba(201, 125, 92, 0.55);
}

.chat-voice-card__icon .symbol {
  color: #FFFCF4;
  font-size: 48rpx;
}

.chat-voice-card__hint {
  font-family: "Songti SC", "Noto Serif SC", "PingFang SC", serif;
