.chat-mood-opt--happy .chat-mood-opt__dot { background: #e0a45c; }
.chat-mood-opt--calm .chat-mood-opt__dot { background: #7fa88c; }
.chat-mood-opt--sad .chat-mood-opt__dot { background: #7e89b0; }
.chat-mood-opt__label {
  font-size: 28rpx;
  color: #f3e9e2;
}
.tod-night .chat-mood-opt__label { color: #f1e8f4; }
.chat-mood-sheet__skip {
  text-align: center;
  margin-top: 24rpx;
  font-size: 25rpx;
  color: #b09a8c;
}
.tod-night .chat-mood-sheet__skip { color: #b49ec4; }

.chat-gender-mask {
  position: fixed;
  inset: 0;
  z-index: 95;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  background: rgba(12, 10, 8, 0.72);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}
.chat-gender-sheet {
  width: 100%;
  max-width: 640rpx;
  background: #272019;
  border: 1rpx solid rgba(232, 222, 206, 0.1);
  border-radius: 36rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 40rpx 80rpx -24rpx rgba(8, 8, 16, 0.7);
  animation: chatGenderRise 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.1);
}
@keyframes chatGenderRise {
  from { opacity: 0; transform: translateY(28rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.chat-gender-sheet__kicker {
  display: block;
  text-align: center;
  color: #8a7d6e;
  font-size: 22rpx;
  letter-spacing: 1.2rpx;
}
.chat-gender-sheet__title {
  display: block;
  text-align: center;
  color: #f3e9e2;
  font-size: 44rpx;
  line-height: 1.5;
  margin-top: 16rpx;
}
.chat-gender-sheet__sub {
  display: block;
  text-align: center;
  color: #b09a8c;
  font-size: 25rpx;
  line-height: 1.7;
  margin-top: 14rpx;
  white-space: pre-line;
}
.chat-gender-cards {
  display: flex;
  gap: 22rpx;
  margin: 40rpx 0 8rpx;
}
.chat-gender-card {
  flex: 1;
  text-align: left;
  padding: 12rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(232, 222, 206, 0.1);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  transition: background 0.18s ease, border-color 0.18s ease;
}
.chat-gender-card--on {
  background: rgba(232, 160, 106, 0.12);
  border-color: #e8a06a;
}
.chat-gender-card__pic {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  border-radius: 18rpx;
  overflow: hidden;
  background: #1f1a16;
}
.chat-gender-card__img {
  width: 100%;
  height: 100%;
  display: block;
  filter: saturate(0.9) brightness(0.92);
  transition: filter 0.18s ease;
}
.chat-gender-card--on .chat-gender-card__img {
  filter: none;
}
.chat-gender-card__scrim {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 44%;
  background: linear-gradient(0deg, rgba(20, 16, 12, 0.65), rgba(20, 16, 12, 0));
}
.chat-gender-card__pron {
  position: absolute;
  left: 16rpx;
  bottom: 12rpx;
  font-size: 40rpx;
  color: #fff;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
}
.chat-gender-card__check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #e8a06a;
  color: #2a2018;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(8, 8, 16, 0.4);
  opacity: 0;
  transform: scale(0.6);
  transition: opacity 0.18s ease, transform 0.18s ease;
}
.chat-gender-card--on .chat-gender-card__check {
  opacity: 1;
  transform: scale(1);
}
.chat-gender-card__meta {
  padding: 0 6rpx 4rpx;
}
.chat-gender-card__name {
  display: block;
  font-size: 27rpx;
  color: #f3e9e2;
}
.chat-gender-card__desc {
  display: block;
  font-size: 20rpx;
  color: #8a7d6e;
  margin-top: 6rpx;
}
.chat-gender-confirm {
  width: 100%;
  height: 96rpx;
  margin-top: 32rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.05);
  color: #8a7d6e;
  transition: background 0.18s ease, color 0.18s ease;
}
.chat-gender-confirm--ready {
  background: #e8a06a;
  color: #2a2018;
  box-shadow: 0 14rpx 30rpx -10rpx rgba(232, 160, 106, 0.5);
}
.chat-gender-confirm--pressed {
  opacity: 0.85;
}
.chat-gender-skip {
  text-align: center;
  margin-top: 22rpx;
  color: #8a7d6e;
  font-size: 24rpx;
}
