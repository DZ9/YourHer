<page-meta background-color="{{theme === 'night' ? '#1F2236' : '#EFE8D8'}}" />
<view class="checkin tod-{{theme}}">
  <button class="back" bindtap="back">‹ 返回</button>
  <text class="headline">心情打卡</text>
  <text wx:if="{{!loading && streak}}" class="streak">已连续打卡 {{streak}} 天</text>
  <text wx:if="{{loading}}">读取记录中…</text>
  <view class="choices" wx:else>
    <button wx:for="{{options}}" wx:key="value" class="choice {{mood === item.value ? 'selected' : ''}}" data-mood="{{item.value}}" bindtap="pick">{{item.label}}</button>
  </view>
  <textarea wx:if="{{!loading}}" placeholder="想记下点什么？（可选）" maxlength="120" value="{{note}}" bindinput="noteInput" />
  <text wx:if="{{error}}" class="error">{{error}}</text>
  <button class="save" loading="{{busy}}" disabled="{{loading || busy || !mood}}" bindtap="save">{{today && today.source !== 'inferred' ? '更新今天的打卡' : '保存今天的打卡'}}</button>
  <button wx:if="{{today && today.source !== 'inferred'}}" bindtap="chat">聊聊今天的心情</button>
</view>
