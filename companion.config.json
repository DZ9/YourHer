{
  "brand": {
    "name": "CompanionKit",
    "description": "A companion that remembers."
  },
  "assistant": {
    "name": "Alex",
    "appearance": "female"
  },
  "timeZone": "UTC",
  "i18n": {
    "defaultLocale": "en",
    "fallbackLocale": "en",
    "detectBrowserLanguage": false,
    "locales": [
      {
        "code": "en",
        "label": "English",
        "file": "packages/i18n/locales/en.json",
        "speechLocale": "en-US",
        "direction": "ltr"
      },
      {
        "code": "zh-CN",
        "label": "简体中文",
        "file": "packages/i18n/locales/zh-CN.json",
        "speechLocale": "zh-CN",
        "direction": "ltr"
      }
    ]
  },
  "features": {
    "memory": true,
    "chips": true,
    "letters": true,
    "mood": true,
    "voice": true,
    "feedback": true
  }
}
