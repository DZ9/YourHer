{
  "name": "yourher",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/web/server.js",
    "test": "node --test packages/memory/test/*.test.js packages/conversation/test/*.test.js packages/i18n/test/*.test.js apps/web/test/*.test.js",
    "eval": "node scripts/evals/run.js",
    "check:miniapp": "node scripts/check-miniapp.mjs",
    "docker": "docker compose --project-directory . -f deploy/compose.yml up --build"
  },
  "license": "MIT",
  "description": "A modular, multilingual, self-hosted companion AI with a complete web application."
}
